project       = "at-utility"
leader_region = "us-east-1"
edge_regions  = ["us-west-2", "eu-west-2", "ap-northeast-1"]
domain_name   = "api.withohm.dev"
image_tag     = "0.1.3"

# Section D — edge VPCs + regional RL Redis (costful). Keep false pre-revenue.
enable_edges = false

# Live single-region size. Only bump to cache.r6g.large+ when re-enabling
# Global Datastore / enable_edges (see MESH_PHASE3_5.md) — r6g.large alone
# is ~$360+/mo and will torch a ~$100 bill.
redis_node_type              = "cache.t4g.small"
# 1 = single primary (slim ~$20/mo vs Multi-AZ). Set 2 when HA matters again.
redis_num_cache_clusters     = 1
redis_snapshot_retention_days = 3

# Section C — EKS in leader VPC for public API NLB (~$73 CP + node)
enable_eks          = true
eks_desired_nodes   = 1

# SNS email for uptime alarms (admin@withohm.dev). Keep false pre-revenue;
# Slack/Chatbot can still consume the ohm-alerts topic. See EMAIL_ALERTS.md.
enable_email_alerts = false

# Section E — Global Accelerator (~$20-40/mo). Keep false; DNS should CNAME
# api → us-east-1 NLB. Confirm no leftover GA in console if the bill still
# shows GlobalAccelerator.
anycast_enabled = false
# After k8s_deploy: map region => NLB ARN for Global Accelerator endpoint groups
ga_nlb_endpoint_arns = {
  # "us-east-1" = "arn:aws:elasticloadbalancing:us-east-1:ACCOUNT:loadbalancer/net/...."
  # "us-west-2" = "arn:aws:elasticloadbalancing:us-west-2:ACCOUNT:loadbalancer/net/...."
  # "eu-west-2" = "arn:aws:elasticloadbalancing:eu-west-2:ACCOUNT:loadbalancer/net/...."
}

# Pass via env TF_VAR_openai_api_key / TF_VAR_at_api_keys — do not commit secrets
# openai_api_key = ""
# at_api_keys    = ""
