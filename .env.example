# Gateway
# Bootstrap key for local Compose only. Production issues keys via POST /v1/admin/tenants.
AT_API_KEYS=sk-at-dev
AT_REGION=local
AT_HOST=0.0.0.0
AT_PORT=8080
AT_CACHE_TTL_SECONDS=3600
AT_RATE_LIMIT_RPS=20
AT_RATE_LIMIT_BURST=40
# Comma-separated admin keys allowed to mint tenants (defaults to AT_API_KEYS if empty)
AT_ADMIN_API_KEYS=sk-at-dev

# Redis (Docker Compose service hostname when running in Compose)
# Single-region / local Phase 0–1: GET replica, SET+RL primary (compose overrides below).
REDIS_URL=redis://redis-replica:6379/0
REDIS_WRITE_URL=redis://redis:6379/0
REDIS_RL_URL=redis://redis:6379/0
# Production leader (Phase 2): REDIS_URL=rediss://READER:6379/0 REDIS_WRITE_URL=rediss://PRIMARY:6379/0
# Edge mesh (Phase 3): REDIS_URL=local Global Datastore secondary, WRITE=leader primary, RL=regional
# Optional Upstash REST (unused by build_store — leave empty)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Providers — put LIVE secrets only in .env (never commit them)
OPENAI_API_KEY=
# Must be the API host, never https://platform.openai.com/...
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
AT_DEFAULT_MODEL=mock
AT_FALLBACK_MODEL=mock

# Ingestion worker
INGEST_WORKER_URL=http://ingest-worker:8090
PLAYWRIGHT_TIMEOUT_MS=30000
SERP_PROVIDER=duckduckgo

# Legal compliance (docs/LEGAL.md) — keep enforced in production
AT_COMPLIANCE_ENFORCE=true
AT_COMPLIANCE_REQUIRE_ACK=true
AT_COMPLIANCE_REQUIRE_TERMS_ACK=true
AT_COMPLIANCE_JURISDICTION=uk_us
AT_COMPLIANCE_RESPECT_ROBOTS=true
AT_COMPLIANCE_REDACT_PII=true
AT_COMPLIANCE_MAX_CHARS_PER_SOURCE=4000
AT_COMPLIANCE_MAX_CONTEXT_CHARS=12000
AT_COMPLIANCE_ALLOW_CACHE_TRAINING=false
AT_COMPLIANCE_TERMS_VERSION=tos-2026-07-26
AT_COMPLIANCE_DPA_VERSION=dpa-2026-07-26
AT_COMPLIANCE_USER_AGENT="OhmBot/0.1 (+https://www.withohm.dev/docs/legal; public-retrieval; respect-robots)"

# Metering / pricing (withOhm pipe rent — not provider token wholesale)
AT_PRICE_PER_1K_TOKENS_MISS=0.002
AT_PRICE_PER_1K_TOKENS_HIT=0.0005
AT_PRICE_PER_FETCH=0.001
AT_ENTERPRISE_MONTHLY_USD=2500
AT_ENV=local
AT_FREE_TIER_FETCH_CAP_DAY=100
# Days after first invoice.payment_failed before API hard-suspend (align with Smart Retries)
AT_DELINQUENT_SUSPEND_DAYS=14
AT_REQUIRE_METER_PRICES=false
# Local/dev: allow OPENAI_API_KEY / ANTHROPIC_API_KEY when X-Ohm-Upstream-Key absent
AT_BYOK_ALLOW_ENV_FALLBACK=true

# Stripe — $0 Intermediate membership + Billing Meters (required in production)
# Create: bash scripts/stripe_create_test_prices.sh && bash scripts/stripe_create_meters.sh
# Docs: docs/STRIPE.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PAYG=
STRIPE_PRICE_CREDIT_PACK=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_METER_WEB_FETCH=
STRIPE_PRICE_METER_CACHE_HIT=
STRIPE_PRICE_METER_CACHE_MISS=
STRIPE_METER_EVENT_WEB_FETCH=ohm_web_fetch
STRIPE_METER_EVENT_CACHE_HIT=ohm_cache_hit
STRIPE_METER_EVENT_CACHE_MISS=ohm_cache_miss
STRIPE_CHECKOUT_SUCCESS_URL=https://www.withohm.dev/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://www.withohm.dev/billing/cancel

# Design-partner defaults (plan=design_partner on admin issue)
AT_DESIGN_PARTNER_DAYS=90
AT_DESIGN_PARTNER_SOFT_QUOTA_USD=50
AT_DESIGN_PARTNER_REQUEST_CAP=100000
